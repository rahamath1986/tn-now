PORT=8080
APP_ENV=development
DATABASE_URL=postgres://postgres:password123@localhost:5432/tnnow_dev?sslmode=disable
REDIS_URL=redis://localhost:6379
JWT_SECRET=tnnow-default-secret-key-32-chars-long!
JWT_ISSUER=tn-now
JWT_AUDIENCE=tn-now-client
ALLOWED_VIDEO_DOMAINS=*.youtube.com,youtu.be,*.instagram.com,instagram.com,*.facebook.com,facebook.com
CORS_ALLOWED_ORIGINS=*

# Email Provider Configuration (resend or smtp)
# Use 'resend' for HTTPS delivery over Port 443 (ideal for Cloud VPS with blocked SMTP ports)
EMAIL_PROVIDER=resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=TN24 News <onboarding@resend.dev>

# Standard SMTP Configuration (Alternative to Resend)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@tn24.in

# ImageKit CDN Configuration (Zero-Server Storage Image Hosting)
IMAGEKIT_URL_ENDPOINT=
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_FOLDER=/articles

